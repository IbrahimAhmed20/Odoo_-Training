<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Estate Property -->
    <record id="view_estate_property_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree string="Estate Properties">
                <field name="name"/>
                <field name="property_code"/>
                <field name="expected_price"/>
                <field name="available_on_web"/>
                <field name="sales_state"/>
                <field name="sales_agent_id"/>
                <field name="property_type_id"/>
                <field name="commission_amount"/>
            </tree>
        </field>
    </record>
    
    <!-- Form View for Estate Property -->
    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property Form">
                <xpath expr="//header" position="inside">
                    <button name="%(action_property_report)d" type="action" string="Print Report" class="btn-primary"/>
                </xpath>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="property_code" readonly="1"/>
                        <field name="expected_price" />
                        <field name="available_on_web"/>
                        <field name="sales_agent_id"/>
                        <field name="creation_date" readonly="1"/>
                        <field name="sales_state"/>
                        <field name="property_type_id"/>
                        <field name="commission_amount" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>  
    </record> 
</odoo>
